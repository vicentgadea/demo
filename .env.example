# ──────────────────────────────────────────────────────────────────────────────
# Stock Analyzer – .env.example
# Copia este archivo como .env y rellena los valores.
# ──────────────────────────────────────────────────────────────────────────────

# --- Servidor ---
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# --- Proveedor de datos primario ---
# Opciones: yfinance | alpha_vantage | finnhub
DATA_PROVIDER=yfinance

# --- Alpha Vantage (opcional, https://www.alphavantage.co/support/#api-key) ---
ALPHA_VANTAGE_API_KEY=

# --- Finnhub (opcional, https://finnhub.io/dashboard) ---
FINNHUB_API_KEY=

# --- Caché (segundos) ---
CACHE_TTL_PRICES=300       # 5 minutos
CACHE_TTL_FUNDAMENTALS=3600  # 1 hora

# --- Frontend ---
BACKEND_URL=http://localhost:8000

# --- Logging ---
LOG_LEVEL=INFO
